  "description": "AlbMap REST API — serves the Flutter mobile app, Next.js website, and Next.js admin portal from one MySQL-backed backend.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
