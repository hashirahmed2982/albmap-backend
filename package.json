    "express-validator": "^7.2.0",
    "firebase-admin": "^12.4.0",
    "google-auth-library": "^9.14.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
