# Server
PORT=4000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=albmap_user
DB_PASSWORD=changeme
DB_NAME=albmap
DB_CONNECTION_LIMIT=10

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins (website + admin portal)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Firebase Admin SDK (for push notification broadcast — see docs/FCM_SETUP.md)
# Path to your Firebase service account JSON, or set the individual fields.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Email (see src/modules/notifications/email.js) — welcome emails, password
# reset, business-submitted confirmations, admin new-business alerts, contact
# form. Leave SMTP_HOST unset and the app degrades to logging "would send"
# instead of crashing — fine for local dev, not fine for production.
#
# Works with Mailtrap out of the box for local testing:
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#
# For production, point this at a real transactional provider (SES, Postmark,
# SendGrid's SMTP relay, Mailgun, ...). SMTP_FROM_ADDRESS's domain MUST be a
# domain you've verified with that provider (SPF/DKIM DNS records added,
# domain marked verified in their dashboard) — sending "From" an unverified
# domain gets the whole send rejected by the provider with a 550 error
# ("Sending from domain X is not allowed"), it's not something fixable in
# this app's code. Verifying a subdomain (e.g. mail.albmap.app) does NOT
# also verify the bare apex domain (albmap.app) — they're separate checks
# to the provider, so SMTP_FROM_ADDRESS has to use the exact (sub)domain
# you actually verified, not just something that looks like it belongs to
# your brand.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=AlbMap <no-reply@mail.albmap.app>

# Where admin-facing emails go (new business submitted, contact form) —
# leave unset to fall back to every user with role='admin' for the
# new-business alert; the contact form has no such fallback and just won't
# send if this is unset.
ADMIN_NOTIFICATION_EMAIL=

# Used to build links inside emails (password reset, "review in admin
# portal") — should be the public URL of the website, not the backend.
WEBSITE_URL=http://localhost:3001

# Initial admin account, created by db:seed if no admin exists yet
SEED_ADMIN_EMAIL=admin@albmap.app
SEED_ADMIN_PASSWORD=ChangeThisPassword123!

# Google Sign-In — the Web application OAuth client ID (from Google Cloud
# Console), used to verify ID tokens from ALL platforms (Android/iOS/web),
# not just the web one — see src/config/env.js's comment.
GOOGLE_CLIENT_ID=

# Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Sign in with Apple — see docs/APPLE_SIGN_IN_SETUP.md for how to obtain
# each of these from the Apple Developer portal.
# The iOS app's own bundle ID (native sign-in mints tokens with this as
# their audience) — matches ios/Runner.xcodeproj's PRODUCT_BUNDLE_IDENTIFIER.
APPLE_BUNDLE_ID=com.albmap.app
# The Services ID created for Android + the website's sign-in flow (both
# go through Apple's web page, which mints tokens with THIS as their
# audience instead of the bundle ID).
APPLE_SERVICES_ID=
# The Android app's applicationId — used only to build the deep link back
# into the app after Apple's web sign-in page redirects here.
APPLE_ANDROID_PACKAGE_ID=com.albmap.app
