# Server
PORT=4000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=albmap_user
DB_PASSWORD=changeme
DB_NAME=albmap
DB_CONNECTION_LIMIT=10

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins (website + admin portal)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Firebase Admin SDK (for push notification broadcast — see docs/FCM_SETUP.md)
# Path to your Firebase service account JSON, or set the individual fields.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Initial admin account, created by db:seed if no admin exists yet
SEED_ADMIN_EMAIL=admin@albmap.app
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
